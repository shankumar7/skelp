{
  "expo": {
    "name": "Skelp!",
    "slug": "skelp",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skelp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.classcom.skelp"
    },
    "android": {
      "package": "com.classcom.skelp",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "packagingOptions": {
              "exclude": [
                "org/bouncycastle/pqc/**",
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            },
            "extraProguardRules": "# Skelp: the LAN socket module is looked up by name from JavaScript\n-keep class com.asterinet.react.tcpsocket.** { *; }\n-dontwarn org.bouncycastle.**\n-dontwarn javax.naming.**"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Skelp! uses the camera to scan the host's QR code and join their arena.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "updates": {
      "enabled": false,
      "checkOnLaunch": "NEVER"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "IPL-style player auction game for friends. Auctions run offline over Wi-Fi or a hotspot; accounts and stats sync with Firebase when online."
  }
}

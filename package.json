{
  "name": "skelp",
  "main": "expo-router/entry",
  "version": "1.5.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:apk": "bash scripts/build-apk.sh",
    "postinstall": "node scripts/patch-tcp-socket.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/luckiest-guy": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.2",
    "@react-native-firebase/auth": "26.4.2",
    "@react-native-firebase/crashlytics": "^26.4.2",
    "@react-native-firebase/firestore": "26.4.2",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "license": "MIT",
  "description": "Offline IPL-style player auction game for friends on the same Wi-Fi or hotspot.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shankumar7/skelp.git"
  }

rules_version = '2';

// Skelp! — each player can only read and write their own document, users/{uid}.
// Publish in Firebase console > Firestore Database > Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'avatar', 'avatarIdx', 'stats', 'history', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
          && d.avatar is string && d.avatar.size() <= 32
          && d.avatarIdx is int && d.avatarIdx >= 0 && d.avatarIdx < 32
          && d.stats is map && d.stats.keys().hasOnly(['auctions', 'wins', 'spent'])
          && d.history is list && d.history.size() <= 10;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validProfile();
    }
    // nothing else is readable or writable
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
